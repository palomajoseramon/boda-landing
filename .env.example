# Copiar a .env.local y rellenar. El archivo .env.local nunca se sube al repo.

# URL de la aplicación web de Apps Script vinculada a la hoja de cálculo.
# Se obtiene en: Extensiones → Apps Script → Implementar → Aplicación web
RSVP_SHEET_URL=

# Cadena compartida entre la web y el script. Debe coincidir exactamente con
# la constante TOKEN de docs/apps-script.gs. Al ser la URL pública, es lo
# único que impide que un tercero escriba filas.
RSVP_TOKEN=
